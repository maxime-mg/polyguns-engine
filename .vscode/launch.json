            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "CMake: Build"
        },
        {
            "name": "Debug polyguns-engine (macOS / lldb)",
            "type": "cppdbg",
            "request": "launch",
            "MIMode": "lldb",
            "program": "${workspaceFolder}/build/polyguns-engine",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "CMake: Build"
        }
    ]
}
